{
  "name": "@beabee/frontend",
  "version": "0.45.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "yarn build:main && yarn build:embed",
    "build:main": "vite build",
    "build:embed": "vite build -c vite.config.public.ts",
    "serve": "vite preview",
    "i18n": "node scripts/i18n.cjs $(git rev-parse --symbolic-full-name --abbrev-ref HEAD)",
    "check": "yarn check:vue-tsc && yarn check:eslint && yarn check:prettier",
    "check:vue-tsc": "vue-tsc --noEmit -p tsconfig.build.json",
    "check:eslint": "eslint 'src/**/*.{ts,vue}'",
    "check:prettier": "prettier -c .",
    "format": "prettier --write .",
    "generate:index": "dev-cli generate-index --extension none --baseDir $(pwd) -p ./src/type ./src/lib ./src/utils ./src/utils/api",
    "test": "vitest run"
  },
  "dependencies": {
    "@appsignal/javascript": "^1.6.1",
    "@beabee/beabee-common": "workspace:^",
    "@beabee/client": "workspace:^",
    "@beabee/fontawesome": "workspace:^",
    "@beabee/locale": "workspace:^",
    "@beabee/vue": "workspace:^",
    "@captchafox/vue": "^1.7.0",
    "@formio/vue": "5.0.0",
    "@iframe-resizer/child": "^5.5.9",
    "@iframe-resizer/parent": "^5.5.9",
    "@maptiler/client": "^2.7.0",
    "@maptiler/geocoding-control": "^1.4.1",
    "@nuxt/ui": "^4.12.0",
    "@stripe/stripe-js": "^3.5.0",
    "@types/body-scroll-lock": "^3.1.2",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "body-scroll-lock": "^4.0.0-beta.0",
    "date-fns": "^4.4.0",
    "formiojs": "npm:@beabee/formiojs@^4.15.15",
    "maplibre-gl": "^3.6.2",
    "mitt": "^3.0.1",
    "otpauth": "^9.6.0",
    "slugify": "^1.6.9",
    "vue": "^3.5.45",
    "vue-maplibre-gl": "^3.1.3",
    "vue-router": "^5.4.0",
    "vuedraggable": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@beabee/dev-cli": "workspace:^",
    "@beabee/prettier-config": "workspace:^",
    "@beabee/tsconfig": "workspace:^",
    "@eslint/js": "^9.39.4",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@rollup/plugin-replace": "^6.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "formiojs": "npm:@beabee/formiojs@^4.15.15"
  }
}
