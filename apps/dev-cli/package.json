{
  "name": "@beabee/dev-cli",
  "description": "CLI for development",
  "version": "0.45.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "bin": "./bin/dev-cli.js",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "./src/index.ts",
    "check": "tsc --noEmit --project tsconfig.json",
    "format": "prettier --write .",
    "generate:index": "yarn start generate-index -p ./src/types ./src/actions ./src/commands --extension ts"
  },
  "dependencies": {
    "typescript": "~7.0.2",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@beabee/prettier-config": "workspace:^",
    "@beabee/tsconfig": "workspace:^",
    "@types/node": "^26.6.6",
    "@types/yargs": "^17.0.35",
    "prettier": "^3.9.10"
  }
}
