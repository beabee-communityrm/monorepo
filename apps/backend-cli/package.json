{
  "name": "@beabee/backend-cli",
  "version": "0.45.0",
  "private": true,
  "main": "dist/index.js",
  "bin": "./dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "check": "concurrently 'yarn:check:*'",
    "check:tsc": "tsc -p ./tsconfig.build.json --noEmit",
    "check:prettier": "prettier -c .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@beabee/core": "workspace:^",
    "@inquirer/prompts": "^8.8.1",
    "chalk": "^6.0.1",
    "csv-parse": "^7.0.3",
    "moment": "^2.31.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@beabee/prettier-config": "workspace:^",
    "@beabee/tsconfig": "workspace:^",
    "concurrently": "^10.0.7",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  }
}
