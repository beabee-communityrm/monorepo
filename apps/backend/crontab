# Add node to the PATH
PATH=/usr/local/bin:/usr/bin:/bin

# Every tenant's cron-app runs this same crontab, and each job spawns a full
# backend-cli boot (~300Mi transient), so simultaneous jobs across co-located
# tenants can stack into a node-level memory burst. Two mechanisms keep
# spawns apart:
#   1. Across tenants: cron-run sleeps a DETERMINISTIC per-pod offset
#      (hash of the pod hostname % 300, stable between pod restarts)
#      before every job.
#   2. Within a tenant: job minutes form a 5-minute grid with no shared
#      minutes, and every long-running job gets >=10 minutes before the next
#      spawn. The shared offset (< 5 min) shifts the whole grid without
#      reordering it.
#
# Every job runs through cron-run (apps/backend/cron-run), which logs its
# start, exit code and duration under a job name and run ID.

# Health check every 15 minutes at :05/:20/:35/:50 (kept off the sync minutes)
5-59/15 * * * * su node -c 'cron-run health yarn backend-cli health all --notify --actor cron' > /proc/1/fd/1 2>&1

# Hourly cron jobs
10 * * * * su node -c 'cron-run newsletter-active-member-tag yarn backend-cli sync newsletter-service active-member-tag --since PT1H10M --actor cron' > /proc/1/fd/1 2>&1
25 * * * * su node -c 'cron-run newsletter-reconcile yarn backend-cli sync newsletter-service reconcile --report --since PT1H10M --fix status groups --actor cron' > /proc/1/fd/1 2>&1
40 * * * * su node -c 'cron-run newsletter-refresh-cached-groups yarn backend-cli sync newsletter-service refresh-cached-groups --actor cron' > /proc/1/fd/1 2>&1

# Daily cron jobs
0  1 * * * su node -c 'cron-run newsletter-clear-pending-status yarn backend-cli sync newsletter-service clear-pending-status --actor cron' > /proc/1/fd/1 2>&1
15 1 * * * su node -c 'cron-run database-clean yarn backend-cli database clean --actor cron' > /proc/1/fd/1 2>&1
30 1 * * * su node -c 'cron-run process-segments node ./dist/tools/process-segments.js' > /proc/1/fd/1 2>&1
