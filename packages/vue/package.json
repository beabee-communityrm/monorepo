{
  "name": "@beabee/vue",
  "description": "Vue components for Beabee",
  "version": "0.45.0",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "docs:start": "histoire preview",
    "docs:dev": "histoire dev",
    "docs:build": "yarn build:lib && yarn build:styles && histoire build",
    "build:lib": "vite build",
    "build:styles": "vite build --mode styles",
    "format": "prettier --write .",
    "check": "yarn check:tsc && yarn check:prettier",
    "check:tsc": "vue-tsc --noEmit",
    "check:prettier": "prettier -c .",
    "generate:index": "yarn workspace @beabee/dev-cli start generate-index --extension ts --baseDir $(pwd) -p ./src/lib ./src/store ./src/types ./src/utils"
  },
  "dependencies": {
    "@beabee/beabee-common": "workspace:^",
    "@bobthered/tailwindcss-palette-generator": "^4.0.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/fira-sans-condensed": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@nuxt/ui": "^4.12.0",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-typography": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/vue-3": "^3.33.0",
    "@vuelidate/core": "^2.0.3",
    "color2k": "^2.0.4",
    "colorjs.io": "~0.6.1",
    "dompurify": "^3.4.17",
    "import-meta-resolve": "^4.2.0",
    "qrcode-generator": "1.5.0",
    "vue": "^3.5.45",
    "vue-accessible-color-picker": "^6.0.0",
    "vue-i18n": "^11.4.18",
    "vue-multiselect": "^3.5.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@beabee/prettier-config": "workspace:^",
    "@beabee/tsconfig": "workspace:^",
    "@histoire/plugin-vue": "^1.0.0-beta.1",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "histoire": "^1.0.0-beta.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "8.3.7",
    "vue-tsc": "^3.3.14"
  },
  "files": [
    "src/"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components-path": "./src/components",
    "./components": "./src/components/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./plugins/*": "./src/plugins/*.js",
    "./store/*": "./src/store/*.ts",
    "./types": "./src/types/index.ts",
    "./styles/*": "./src/styles/*.css",
    "./styles": "./src/styles/index.css",
    "./assets/*": "./src/assets/*"
  }
}
